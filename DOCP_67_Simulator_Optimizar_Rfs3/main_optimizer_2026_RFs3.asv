% Response(:,ku)=[nrf;FVAL;length(Bxx);NSepTi;TAPs;elapsedtime;i;nf;sel2;speed2;sen2;minSepTime];
iters=iters+1;  
aaSolution(iters,:) = [FVAL sel sen AvgPrimSpeed];
end
